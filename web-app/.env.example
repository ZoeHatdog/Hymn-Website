WEB_PORT=3001
WEB_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000

# Session cookie signature. Use a long random string.
AUTH_SECRET=
# Optional comma-separated list. When set, only these emails can sign in.
AUTH_ALLOWED_EMAILS=

# Google OAuth client. Redirect URI must be the desk origin, through the Vite proxy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Gmail account that sends the 6-digit sign-in code. Use an app password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_ENDPOINT=